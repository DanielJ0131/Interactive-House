# Serial
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=9600

# File-based local bridge (MVP)
# Control file is read by gateway -> commands sent to Arduino.
CONTROL_FILE=runtime/control.json

# Parsed STATE lines are persisted here.
STATE_FILE=runtime/last_state.json

# Poll interval for control file updates.
CONTROL_POLL_MS=250

# Firestore mode (optional). If all three are set, gateway runs Firestore sync mode.
PROJECT_ID=
WATCH_DOC=devices/arduino
SERVICE_ACCOUNT_PATH=config/serviceAccountKey.json
MUSIC_COLLECTION=music
FIRESTORE_POLL_MS=700
